<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - موعد طبي</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg app-navbar fixed-top">
        <div class="container">
            <a class="navbar-brand brand" asp-controller="Home" asp-action="Index">
                <i class="bi bi-heart-pulse-fill"></i>  موعد طبي
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">الرئيسية</a></li>

                   @if (User.IsInRole("Patient"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Booking" asp-action="Book">احجز دور</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Booking" asp-action="MyQueue">دوري</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Booking" asp-action="History">حجوزاتي</a></li>
                    }
                </ul>

                <ul class="navbar-nav align-items-lg-center gap-lg-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <span class="nav-link"><i class="bi bi-person-circle"></i> @User.Identity.Name</span>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-box-arrow-left"></i>  تسجيل الخروج
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">تسجيل دخول</a></li>
                        <li class="nav-item"><a class="btn btn-gradient btn-sm px-3" asp-controller="Account" asp-action="Register">إنشاء حساب</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="text-center text-muted small py-4">عيادة الدور © @DateTime.Now.Year</footer>

    <div id="toastArea" class="toast-container position-fixed bottom-0 start-0 p-3"
         data-success="@TempData["Success"]" data-error="@TempData["Error"]"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>