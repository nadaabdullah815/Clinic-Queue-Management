@model ClinicAppointments.Models.Doctor
@{
    ViewData["Title"] = "الرئيسية";
}

<section class="hero text-center">
    <span class="badge-soft reveal"><i class="bi bi-stars"></i> دون انتظار في العيادة</span>
    <h1 class="display-5 fw-bold reveal" data-delay="1">احجز دورك <span class="gradient-text">من منزلك</span></h1>
    <p class="lead text-muted reveal" data-delay="2">احصل على رقمك،و تابع ترتيبك لحظة بلحظة، و اذهب الى العيادة عند اقتراب دورك.</p>

    <div class="doctor-chip glass-card d-inline-flex align-items-center gap-3 reveal" data-delay="3">
        <div class="avatar"><i class="bi bi-person-badge-fill"></i></div>
        <div class="text-start">
            <div class="fw-bold">@Model.Name</div>
            <div class="text-muted small">@Model.Specialty · @Model.WorkStartTime.ToString("HH:mm") - @Model.WorkEndTime.ToString("HH:mm")</div>
        </div>
        <span class="status-pill @(Model.IsAcceptingBookings ? "open" : "closed")">
            @(Model.IsAcceptingBookings ? "الحجز مفتوح" : "الحجز مغلق")
        </span>
    </div>

    <div class="mt-3 d-flex gap-2 justify-content-center flex-wrap reveal" data-delay="3">
        @if (User.IsInRole("Patient"))
        {
            <a class="btn btn-gradient btn-lg px-4" asp-controller="Booking" asp-action="Book"><i class="bi bi-ticket-perforated"></i> احجز دور</a>
            <a class="btn btn-outline-primary btn-lg px-4" asp-controller="Booking" asp-action="MyQueue">دوري</a>
        }
        else if (User.Identity?.IsAuthenticated != true)
        {
            <a class="btn btn-gradient btn-lg px-4" asp-controller="Account" asp-action="Register">ابدأ الان</a>
            <a class="btn btn-outline-primary btn-lg px-4" asp-controller="Account" asp-action="Login">تسجيل الدخول</a>
        }
    </div>
</section>

<section class="row g-4 mt-4">
    <div class="col-md-4 reveal" data-delay="1">
        <div class="glass-card hoverable text-center h-100">
            <div class="feature-icon"><i class="bi bi-phone"></i></div>
            <h5 class="fw-bold">احجز بضغطة واحدة</h5>
            <p class="text-muted mb-0">احصل على رقمك في الدور فوراً دون اتصال أو زيارة.</p>
        </div>
    </div>
    <div class="col-md-4 reveal" data-delay="2">
        <div class="glass-card hoverable text-center h-100">
            <div class="feature-icon"><i class="bi bi-activity"></i></div>
            <h5 class="fw-bold">تابع ترتيبك مباشرة</h5>
            <p class="text-muted mb-0">اطلع على الدور الحالي و عدد المنتظرين قبلك، والصفحة تتحدث تلقائياً.</p>
        </div>
    </div>
    <div class="col-md-4 reveal" data-delay="3">
        <div class="glass-card hoverable text-center h-100">
            <div class="feature-icon"><i class="bi bi-alarm"></i></div>
            <h5 class="fw-bold">وفّر وقتك</h5>
            <p class="text-muted mb-0">   يصلك تنبيه عند اقتراب دورك، فلا حاجة للانتظار في العيادة.</p>
        </div>
    </div>
</section>