<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - عيادة أسنان</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg app-navbar fixed-top">
        <div class="container">
          <a class="navbar-brand brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
             <svg class="brand-tooth" viewBox="0 0 72 64" width="34" height="30" aria-hidden="true">
                 <defs>
                     <linearGradient id="toothGrad" x1="0" y1="0" x2="1" y2="1">
                         <stop offset="0" stop-color="#0ea5a4" />
                         <stop offset="1" stop-color="#2563eb" />
                     </linearGradient>
                 </defs>
                 <path d="M20 6 C14 6 8 10 8 18 C8 26 12 30 13 38 C14 46 15 58 20 58 C25 58 25 46 27 40 C28 37 29 36 32 36 C35 36 36 37 37 40 C39 46 39 58 44 58 C49 58 50 46 51 38 C52 30 56 26 56 18 C56 10 50 6 44 6 C40 6 36 9 32 9 C28 9 24 6 20 6 Z"
                       fill="url(#toothGrad)" />
                 <path d="M16 14 C14 16 14 20 15 23" fill="none" stroke="#fff" stroke-opacity=".75"
                       stroke-width="2.5" stroke-linecap="round" />
                 <path class="brand-sparkle" d="M64 3 L66 8 L71 10 L66 12 L64 17 L62 12 L57 10 L62 8 Z" fill="#fbbf24" />
             </svg>
             <span>  عيادة أسنان</span>
        </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">الرئيسية</a></li>

                   @if (User.IsInRole("Patient"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Booking" asp-action="Book">احجز دور</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Booking" asp-action="MyQueue">دوري</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Booking" asp-action="History">حجوزاتي</a></li>
                    }
                     @if (User.IsInRole("Doctor"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="DoctorQueue" asp-action="Dashboard">لوحة التحكم</a></li>
                    }
                </ul>

                <ul class="navbar-nav align-items-lg-center gap-lg-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <span class="nav-link"><i class="bi bi-person-circle"></i> @User.Identity.Name</span>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-box-arrow-left"></i>  تسجيل الخروج
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">تسجيل دخول</a></li>
                        <li class="nav-item"><a class="btn btn-gradient btn-sm px-3" asp-controller="Account" asp-action="Register">إنشاء حساب</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="text-center text-muted small py-4">  عيادة أسنان © @DateTime.Now.Year</footer>

    <div id="toastArea" class="toast-container position-fixed bottom-0 start-0 p-3"
         data-success="@TempData["Success"]" data-error="@TempData["Error"]"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>