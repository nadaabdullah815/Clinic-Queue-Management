@model ClinicQueue.ViewModels.RegisterVM
@{
    ViewData["Title"] = "إنشاء حساب";
}

<div class="auth-wrap">
    <div class="auth-card reveal">
        <div class="auth-icon"><i class="bi bi-person-plus-fill"></i></div>
        <div class="glass-card">
            <h3 class="text-center fw-bold mb-1"> انشاء حساب</h3>
            <p class="text-center text-muted mb-4">أنشئ حساب و احجز دورك دون انتظار</p>

            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Name" class="form-control" placeholder="الاسم" autocomplete="off" data-no-autofill data-letters-only  />
                    <label asp-for="Name"></label>
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Phone" class="form-control" placeholder="رقم الهاتف" autocomplete="off" data-no-autofill />
                    <label asp-for="Phone"></label>
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3 pw-wrap">
                    <input asp-for="Password" class="form-control" placeholder="كلمة المرور"  autocomplete="new-password" data-no-autofill />
                    <label asp-for="Password"></label>
                    <button type="button" class="pw-toggle" data-toggle-password><i class="bi bi-eye"></i></button>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-4 pw-wrap">
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="تأكيد كلمة المرور"  autocomplete="new-password" data-no-autofill  />
                    <label asp-for="ConfirmPassword"></label>
                    <button type="button" class="pw-toggle" data-toggle-password><i class="bi bi-eye"></i></button>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-gradient w-100 py-2">إنشاء الحساب</button>
            </form>

            <p class="text-center mt-3 mb-0">لديك حساب؟ <a asp-action="Login">تسجيل الدخول</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}