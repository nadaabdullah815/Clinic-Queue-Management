@model ClinicQueue.ViewModels.BookPageVM
@{
    ViewData["Title"] = "احجز دور";
}

<div class="auth-wrap">
    <div class="auth-card reveal" style="max-width:520px">
        <div class="auth-icon"><i class="bi bi-ticket-perforated-fill"></i></div>

        <div class="glass-card text-center">
            <h3 class="fw-bold mb-1">@Model.Doctor.Name</h3>
            <p class="text-muted">@Model.Doctor.Specialty</p>
             
             @if (!string.IsNullOrWhiteSpace(Model.Doctor.Location))
            {
                <p class="small text-muted"><i class="bi bi-geo-alt-fill"></i> @Model.Doctor.Location</p>
            }

            <div class="row g-3 my-3">
                <div class="col-6">
                    <div class="mini-stat">
                        <div class="text-muted small">الدور الحالي</div>
                        <div class="num count-up" data-value="@Model.CurrentNumber">@Model.CurrentNumber</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="mini-stat">
                        <div class="text-muted small">بالانتظار</div>
                        <div class="num count-up" data-value="@Model.WaitingCount">@Model.WaitingCount</div>
                    </div>
                </div>
            </div>
            
            <p class="text-muted small">
                الأماكن المتبقية اليوم: <strong>@Math.Max(0, Model.Capacity - Model.BookedCount)</strong> من @Model.Capacity
            </p>
           @if (!Model.Doctor.IsAcceptingBookings)
            {
                <div class="alert alert-warning mb-0">الحجز مغلق حالياً، يُرجى المحاولة لاحقاً.</div>
            }
            else if (Model.HasActive)
            {
                <div class="alert alert-info">لديك دور فعّال اليوم.</div>
                <a class="btn btn-gradient w-100" asp-action="MyQueue">عرض دوري</a>
            }
            else if (Model.IsFull)
            {
                <div class="alert alert-warning mb-0">
                    اكتمل عدد الحجوزات لهذا اليوم. سيُفتح الحجز تلقائياً إذا أُلغي أحد الحجوزات.
                </div>
            }
            else
            {
                <form asp-action="Confirm" method="post">
                    <button type="submit" class="btn btn-gradient btn-book w-100">
                        <i class="bi bi-lightning-charge-fill"></i> احجز دوري الآن
                    </button>
                </form>
            }
        </div>
    </div>
</div>